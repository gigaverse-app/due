+            report["status"] = "verified"
+        report["artifacts"] = data["artifacts"]
+        return report
+    except (ProjectError, OSError, ValueError, SyntaxError, TypeError, KeyError, tokenize.TokenError) as error:
+        report["error"] = str(error)
+        return report
