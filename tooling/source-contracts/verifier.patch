diff --git a/.github/workflows/source-project.yml b/.github/workflows/source-project.yml
new file mode 100644
index 0000000000000000000000000000000000000000..7e15c29c4c629a1d4aa7633c00ccbf5c02f6a1d2
--- /dev/null
+++ b/.github/workflows/source-project.yml
@@ -0,0 +1,41 @@
+name: Source contract project
+
+on:
+  pull_request:
+  push:
+    branches: [main]
+
+permissions:
+  contents: read
+
+jobs:
+  source-project:
+    runs-on: ubuntu-22.04
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.14.4'
+      - name: Install pinned Dafny
+        shell: bash
+        run: |
+          curl --fail --location --retry 3 https://github.com/dafny-lang/dafny/releases/download/v4.11.0/dafny-4.11.0-x64-ubuntu-22.04.zip --output "$RUNNER_TEMP/dafny.zip"
+          echo 'a46a9ff7cdd720f7955854c78e95df13f4cfe6b80691b05f8654fe19e8267179  '"$RUNNER_TEMP/dafny.zip" | sha256sum --check
+          unzip -q "$RUNNER_TEMP/dafny.zip" -d "$RUNNER_TEMP/proof-tools"
+          chmod +x "$RUNNER_TEMP/proof-tools/dafny/dafny" "$RUNNER_TEMP/proof-tools/dafny/z3/bin/z3-4.12.1"
+          echo "$RUNNER_TEMP/proof-tools/dafny" >> "$GITHUB_PATH"
+      - name: Build wheel with pinned build backend
+        env:
+          SOURCE_DATE_EPOCH: '315532800'
+        run: |
+          python -m pip install --require-hashes -r requirements-build.lock
+          python -m pip wheel --no-build-isolation --no-deps . --wheel-dir build/dist
+      - name: Install wheel in fresh environment
+        run: |
+          python -m venv build/ci-proof
+          build/ci-proof/bin/python -m pip install --require-hashes -r requirements-project.lock
+          build/ci-proof/bin/python -m pip install --no-deps build/dist/veripy-0.1.0a1-py3-none-any.whl
+      - name: Reprove current source and reject stale artifacts
+        working-directory: ${{ runner.temp }}
+        run: |
+          "$GITHUB_WORKSPACE/build/ci-proof/bin/python" -I -m veripy project check "$GITHUB_WORKSPACE/examples/source_contracts/veripy-project.json" --json
