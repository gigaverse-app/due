        "package/src/due/django/conformance/suite_collection.py",
        "package/tests/conformance/test_exploration_collection.py",
        "contracts/python-checks.json",
        "scripts/check_python_contracts.py",
        "scripts/source_contract_utils.py",
        "scripts/file_edits.py"
      ]
    }
  ],
  "artifacts": "proofs/generated",
